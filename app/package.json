{
  "name": "youtubesub-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout=60000 \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --test --test-concurrency=1 --test-force-exit --test-timeout=180000 tests/browser/browser-e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.1",
    "electron": "44.6.0",
    "typescript": "^7.0.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.cometdash.youtubesub",
    "productName": "youtubesub",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "youtubesub-${version}-win64.${ext}"
  }
}
